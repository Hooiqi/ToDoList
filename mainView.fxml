<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);;" BorderPane.alignment="CENTER_LEFT">
         <padding>
            <Insets top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: Sans-serif;" text="To Do List" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Goudy Old Style Bold" size="20.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
            <Button fx:id="btnAddNewTask" alignment="CENTER_RIGHT" contentDisplay="RIGHT" mnemonicParsing="false" style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 10 20 10 20; -fx-background-radius: 6;" text="➕  Add New Task" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Sans Serif Collection" size="12.0" />
               </font>
               <HBox.margin>
                  <Insets bottom="10.0" left="800.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8;">
               <padding>
                  <Insets top="15.0" />
               </padding>
               <children>
                  <Label style="-fx-font-weight: bold;" text="Search">
                     <HBox.margin>
                        <Insets left="30.0" />
                     </HBox.margin>
                  </Label>
                  <TextField fx:id="txtSearch" maxWidth="-Infinity" minHeight="0.0" minWidth="0.0" prefWidth="350.0" promptText="Search tasks" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </TextField>
                  <Label style="-fx-font-weight: bold;" text="Filter">
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="comboFilter" prefWidth="180.0" promptText="Select filter" />
                  <Button fx:id="btnSearch" mnemonicParsing="false" style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold;" text="Search">
                     <HBox.margin>
                        <Insets left="15.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <TableView prefHeight="200.0" prefWidth="200.0" style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colTitle" prefWidth="250.0" text="Title" />
                <TableColumn fx:id="colDescription" prefWidth="450.0" text="Description" />
                  <TableColumn fx:id="colDueDate" prefWidth="140.0" text="Due Date" />
                  <TableColumn fx:id="colCategory" prefWidth="120.0" text="Category" />
                  <TableColumn fx:id="colPriority" prefWidth="120.0" text="Priority" />
                  <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
              </columns>
            </TableView>
         </children>
         <padding>
            <Insets top="15.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox fx:id="lblCompleted" prefHeight="80.0" prefWidth="200.0" spacing="30.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label fx:id="lblTotalTasks" text="Total Tasks: 0">
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
            <Label layoutX="30.0" layoutY="25.0" text="Complted: 0">
               <HBox.margin>
                  <Insets left="20.0" right="20.0" />
               </HBox.margin>
            </Label>
            <Label fx:id="lblPending" layoutX="88.0" layoutY="25.0" text="Pending: 0" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
