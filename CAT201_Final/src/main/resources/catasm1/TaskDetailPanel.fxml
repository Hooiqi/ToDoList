<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="500.0" stylesheets="@TaskDetailPanel.css" style="-fx-background-color: #f7f6fb;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="catasm1.TaskDetailPanelController">
   <children>
      <Label prefHeight="120.0" prefWidth="500.0" style="-fx-background-color: #AC87C5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0, 0, 5);" text="  Task Details" textFill="WHITE">
         <font>
            <Font name="ROGFonts-Regular" size="24.0" />
         </font>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets bottom="20.0" top="20.0" />
         </padding>
      </Label>
      
      <VBox fx:id="editBox" managed="false" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="600.0" spacing="12" style="-fx-background-color: white;" visible="false" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8B7BA8;" text="Edit Task">
               <VBox.margin>
                  <Insets bottom="8.0" />
               </VBox.margin>
            </Label>
            
            <Label style="-fx-text-fill: #8B7BA8; -fx-font-weight: bold; -fx-font-size: 14px;" text="Title *" />
            <TextField fx:id="txtEditTitle" promptText="Enter task title" style="-fx-background-color: white; -fx-border-color: #AC87C5; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;" />
            
            <Label style="-fx-text-fill: #8B7BA8; -fx-font-weight: bold; -fx-font-size: 14px;" text="Description">
               <VBox.margin>
                  <Insets top="3.0" />
               </VBox.margin>
            </Label>
            <TextArea fx:id="txtEditDescription" prefRowCount="2" prefHeight="80.0" promptText="Enter task description" style="-fx-background-color: white; -fx-border-color: #AC87C5; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" wrapText="true" />
            
            <Label style="-fx-text-fill: #8B7BA8; -fx-font-weight: bold; -fx-font-size: 14px;" text="Due Date *">
               <VBox.margin>
                  <Insets top="3.0" />
               </VBox.margin>
            </Label>
            <DatePicker fx:id="dateEditPicker" prefWidth="500" style="-fx-background-color: white; -fx-border-color: #AC87C5; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;" />
            
            <Label style="-fx-text-fill: #8B7BA8; -fx-font-weight: bold; -fx-font-size: 14px;" text="Category *">
               <VBox.margin>
                  <Insets top="3.0" />
               </VBox.margin>
            </Label>
            <ComboBox fx:id="comboEditCategory" prefWidth="500" promptText="Select category" style="-fx-background-color: #f4f2f9; -fx-border-color: #AC87C5; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;" />
            
            <Label style="-fx-text-fill: #8B7BA8; -fx-font-weight: bold; -fx-font-size: 14px;" text="Priority *">
               <VBox.margin>
                  <Insets top="3.0" />
               </VBox.margin>
            </Label>
            <ChoiceBox fx:id="choiceEditPriority" prefWidth="500" style="-fx-background-color: #f4f2f9; -fx-border-color: #AC87C5; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;" />

            <HBox spacing="20" alignment="CENTER">
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="btnSave" mnemonicParsing="false" onAction="#handleSave" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #886891; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 15px;" text="SAVE">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnCancelEdit" mnemonicParsing="false" onAction="#handleCancelEdit" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #e0b1cb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 15px;" text="CANCEL">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox fx:id="viewBox" maxWidth="1.7976931348623157E308" prefHeight="300.0" prefWidth="300.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Title" textFill="#967d7d">
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="10.0" />
               </VBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblDetailTitle">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" />
               </VBox.margin>
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label style="-fx-text-fill: #967d7d;" text="Description">
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </VBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblDetailDescription" wrapText="true">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" />
               </VBox.margin>
            </Label>
            <Label style="-fx-text-fill: #967d7d;" text="Due Date">
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </VBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblDetailDueDate">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" />
               </VBox.margin>
            </Label>
            <Label style="-fx-text-fill: #967d7d;" text="Category">
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </VBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblDetailCategory">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" />
               </VBox.margin>
            </Label>
            <Label style="-fx-text-fill: #967d7d;" text="Priority">
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </VBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblDetailPriority">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" />
               </VBox.margin>
            </Label>
            <Label style="-fx-text-fill: #967d7d;" text="Status">
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </VBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblDetailStatus">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="20.0" />
               </VBox.margin>
            </Label>
         </children>
         <padding>
            <Insets top="12.0" />
         </padding>
      </VBox>
      <VBox fx:id="buttonBox" prefHeight="100.0" prefWidth="200.0">
         <children>
            <HBox spacing="18">
               <children>
                  <Button fx:id="btnComplete" mnemonicParsing="false" onAction="#handleComplete" prefHeight="80.0" prefWidth="140.0" style="-fx-background-radius: 10; -fx-background-color: #9f86c0;" text="Mark as Completed" textAlignment="CENTER" textFill="WHITE" wrapText="true">
                     <font>
                        <Font name="ROGFonts-Regular" size="15.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#handleEdit" prefHeight="80.0" prefWidth="140.0" style="-fx-background-radius: 10; -fx-background-color: #be95c4;" text="Edit Task" textFill="WHITE">
                     <font>
                        <Font name="ROGFonts-Regular" size="15.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#handleDelete" prefHeight="80.0" prefWidth="140.0" style="-fx-background-radius: 10; -fx-background-color: #e0b1cb;" text="Delete Task" textAlignment="CENTER" textFill="WHITE" wrapText="true">
                     <font>
                        <Font name="ROGFonts-Regular" size="15.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>